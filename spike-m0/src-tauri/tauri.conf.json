{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spike-m0",
  "version": "0.1.0",
  "identifier": "com.kalana.spike-m0",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "spike-m0 (M0 window)",
        "width": 640,
        "height": 480,
        "resizable": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
